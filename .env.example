# Copy to .env before using docker compose.
# The API listens on PORT. Compose fixes the container port at 3000 and uses
# APP_PORT_HOST for the host-side port.
NODE_ENV=production
PORT=3000
APP_PORT_HOST=3000

# Optional ScreenApp-compatible backend used for bot status/log reporting and
# uploads. Leave blank for local-only storage: reporting is then disabled and
# skipped with a clear log line. If set, the value must be an absolute http(s)
# URL - the server validates it at startup and fails fast on a bad value.
# API_BASE_URL, BACKEND_URL and APP_URL are accepted aliases.
AUTH_BASE_URL_V2=http://host.docker.internal:8081/v2
SCREENAPP_BACKEND_SERVICE_API_KEY=

# Meeting limits and retry behaviour.
MAX_RECORDING_DURATION_MINUTES=180
MEETING_INACTIVITY_MINUTES=2
INACTIVITY_DETECTION_START_DELAY_MINUTES=5
LONE_PARTICIPANT_EXIT_DELAY_SECONDS=10
JOIN_WAIT_TIME_MINUTES=2
RETRY_COUNT=2
TEAMS_PREWARM_ENABLED=false
TEAMS_AUDIO_STABILIZATION_MS=1000
GOOGLE_ANONYMOUS_JOIN_REQUEST_ATTEMPTS=10

# Browser settings. compose.production.yml sets GOOGLE_CHROME_CDP_URL to its
# bundled Chrome sidecar. Leave these blank unless you manage Chrome yourself.
# When you run the bot outside docker compose/Kubernetes, chrome-cdp does not
# resolve - point GOOGLE_CHROME_CDP_URL at a reachable endpoint instead, e.g.
# http://localhost:9223 or http://host.docker.internal:9223 (CHROME_CDP_URL is
# accepted as an alias). Invalid values fail fast at startup.
CHROME_PATH=/usr/bin/google-chrome
GOOGLE_CHROME_CDP_URL=
GOOGLE_CHROME_USER_DATA_DIR=
GOOGLE_CHROME_STORAGE_STATE_PATH=

# REST mode works with REDIS_CONSUMER_ENABLED=false. Enable it to consume queued jobs.
REDIS_CONSUMER_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_QUEUE_NAME=jobs:meetbot:list
REDIS_PROCESSING_QUEUE_NAME=jobs:meetbot:processing
# Host port for the bundled Redis. Change if 6379 is already occupied.
REDIS_PORT_HOST=6379

# Recording output. The production Compose stack mounts a persistent named volume here.
UPLOADER_FILE_EXTENSION=.webm
UPLOADER_TYPE=local
RECORDINGS_DIR=/recordings
# Dashboard state, account metadata, and auth profiles share this writable root.
# DATA_DIR is accepted as a fallback. Legacy path overrides below still work.
DASHBOARD_DATA_DIR=/data
DASHBOARD_STATE_PATH=/data/meeting-bot-dashboard.json
AUTH_PROFILES_DIR=/data/auth-profiles
# Public URL for the interactive sign-in console when not running on localhost.
AUTH_CONSOLE_URL=http://localhost:6080/vnc.html?autoconnect=1&resize=scale
# Optional fallback for ScreenApp uploader authentication when launched from the dashboard.
DASHBOARD_BEARER_TOKEN=

# Optional completion notifications.
NOTIFY_WEBHOOK_ENABLED=false
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=
NOTIFY_REDIS_ENABLED=false
NOTIFY_REDIS_URI=
NOTIFY_REDIS_DB=1
NOTIFY_REDIS_LIST=jobs:meetbot:recordings
NOTIFY_REDIS_FAILURE_LIST=jobs:meetbot:failures

# Optional GCP bucket used only for diagnostic screenshots.
GCP_ACCESS_KEY_ID=
GCP_SECRET_ACCESS_KEY=
GCP_MISC_BUCKET=
GCP_MISC_BUCKET_FOLDER=meeting-bot
GCP_DEFAULT_REGION=

# Kubernetes-only graceful-shutdown detection. Leave blank in Docker Compose.
POD_NAME=
POD_NAMESPACE=
